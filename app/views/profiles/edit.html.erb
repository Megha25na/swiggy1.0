<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5 bg-white">
        <h1 class="h4 fw-bold mb-1">Edit Profile</h1>
        <p class="text-muted small mb-4">Update your personal and delivery details</p>

        <%= form_with model: @user, url: profile_path, method: :patch, local: true do |f| %>
          <div class="mb-3">
            <%= f.label :name, "Full Name", class: "form-label small fw-bold" %>
            <%= f.text_field :name, class: "form-control rounded-3", required: true %>
          </div>

          <div class="mb-3">
            <%= f.label :email, "Email Address", class: "form-label small fw-bold" %>
            <%= f.email_field :email, class: "form-control rounded-3", disabled: true %>
            <div class="form-text small">Email cannot be changed directly here.</div>
          </div>

          <div class="mb-3">
            <%= f.label :phone, "Phone Number", class: "form-label small fw-bold" %>
            <%= f.telephone_field :phone, class: "form-control rounded-3", placeholder: "e.g. 9876543210" %>
          </div>

          <div class="mb-4">
            <%= f.label :address, "Default Delivery Address", class: "form-label small fw-bold" %>
            <%= f.text_area :address, rows: 3, class: "form-control rounded-3", placeholder: "Flat / House No, Street, Society, Pune" %>
          </div>

          <div class="d-flex gap-2">
            <%= f.submit "Save Changes", class: "btn btn-swigy-primary px-4 py-2" %>
            <%= link_to "Cancel", profile_path, class: "btn btn-light px-4 py-2 rounded-3" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
