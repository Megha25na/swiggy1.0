<div class="container py-4">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <%= link_to "Admin Console", admin_root_path, class: "text-muted small text-decoration-none" %>
        <i class="bi bi-chevron-right text-muted small"></i>
        <h1 class="h3 fw-bold mb-0">Platform Orders</h1>
      </div>
      <p class="text-muted small mb-0">Manage and track all customer orders across the platform</p>
    </div>

    <!-- Filter by status -->
    <div class="filter-bar mb-0">
      <%= link_to "All Orders", admin_orders_path, class: "filter-pill #{'active' unless params[:status].present?}" %>
      <%= link_to "Placed", admin_orders_path(status: "placed"), class: "filter-pill #{'active' if params[:status] == 'placed'}" %>
      <%= link_to "Confirmed", admin_orders_path(status: "confirmed"), class: "filter-pill #{'active' if params[:status] == 'confirmed'}" %>
      <%= link_to "Preparing", admin_orders_path(status: "preparing"), class: "filter-pill #{'active' if params[:status] == 'preparing'}" %>
      <%= link_to "Delivering", admin_orders_path(status: "out_for_delivery"), class: "filter-pill #{'active' if params[:status] == 'out_for_delivery'}" %>
      <%= link_to "Delivered", admin_orders_path(status: "delivered"), class: "filter-pill #{'active' if params[:status] == 'delivered'}" %>
    </div>
  </div>

  <div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead class="table-light small">
          <tr>
            <th>Order ID</th>
            <th>Date & Time</th>
            <th>Customer & Contact</th>
            <th>Restaurant</th>
            <th>Amount</th>
            <th>Payment</th>
            <th>Status</th>
            <th>Update Status</th>
            <th class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if @orders.any? %>
            <% @orders.each do |order| %>
              <tr>
                <td><strong>#SWG-<%= order.id %></strong></td>
                <td><span class="small text-muted"><%= order.created_at.strftime("%b %d, %H:%M") %></span></td>
                <td>
                  <div class="fw-semibold small"><%= order.customer_name %></div>
                  <div class="small text-muted"><%= order.contact_phone %></div>
                </td>
                <td><span class="small fw-semibold"><%= order.restaurant&.name || "N/A" %></span></td>
                <td><strong>₹<%= order.total %></strong></td>
                <td>
                  <span class="small text-muted d-block"><%= order.payment_method %></span>
                </td>
                <td>
                  <span class="<%= order.status_badge_class %>">
                    <%= order.order_status.titleize %>
                  </span>
                </td>
                <td>
                  <%= form_with url: admin_order_path(order), method: :patch, local: true, class: "d-inline-flex gap-1" do %>
                    <select name="order_status" class="form-select form-select-sm" style="width: 140px;" onchange="this.form.submit()">
                      <% Order::STATUSES.each do |st| %>
                        <option value="<%= st %>" <%= 'selected' if order.order_status == st %>><%= st.titleize %></option>
                      <% end %>
                    </select>
                  <% end %>
                </td>
                <td class="text-end">
                  <%= link_to order_path(order), class: "btn btn-sm btn-light border", title: "View Tracking & Receipt" do %>
                    <i class="bi bi-eye"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="9" class="text-center py-4 text-muted">
                No orders found for this status.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
