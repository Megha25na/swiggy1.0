<div class="container py-4">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <%= link_to "Admin Console", admin_root_path, class: "text-muted small text-decoration-none" %>
        <i class="bi bi-chevron-right text-muted small"></i>
        <h1 class="h3 fw-bold mb-0">Restaurants Management</h1>
      </div>
      <p class="text-muted small mb-0">Manage partner eateries, cuisines, timings, and ratings</p>
    </div>

    <div>
      <%= link_to new_admin_restaurant_path, class: "btn btn-swigy-primary rounded-pill px-4" do %>
        <i class="bi bi-plus-lg me-1"></i> Add Restaurant
      <% end %>
    </div>
  </div>

  <div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead class="table-light small">
          <tr>
            <th>Restaurant</th>
            <th>Cuisine</th>
            <th>Rating</th>
            <th>Delivery Time</th>
            <th>Price for Two</th>
            <th>Type</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @restaurants.any? %>
            <% @restaurants.each do |restaurant| %>
              <tr>
                <td>
                  <div class="d-flex align-items-center gap-3">
                    <img src="<%= restaurant.display_image %>" alt="<%= restaurant.name %>" class="rounded-3" style="width: 48px; height: 48px; object-fit: cover;">
                    <div>
                      <div class="fw-bold"><%= restaurant.name %></div>
                      <div class="small text-muted"><%= restaurant.city.presence || "Pune" %> • <%= restaurant.products.count %> dishes</div>
                    </div>
                  </div>
                </td>
                <td><span class="small text-secondary"><%= restaurant.cuisine %></span></td>
                <td>
                  <span class="badge rating-badge"><i class="bi bi-star-fill"></i> <%= restaurant.rating || 4.2 %></span>
                </td>
                <td><span class="small"><%= restaurant.delivery_time %></span></td>
                <td><span class="small fw-semibold">₹<%= restaurant.price_for_two %></span></td>
                <td>
                  <% if restaurant.pure_veg? %>
                    <span class="badge bg-success-subtle text-success">Pure Veg</span>
                  <% else %>
                    <span class="badge bg-light text-muted border">Regular</span>
                  <% end %>
                </td>
                <td class="text-end">
                  <div class="d-inline-flex gap-1">
                    <%= link_to restaurant_path(restaurant), class: "btn btn-sm btn-light border", title: "View Menu" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_admin_restaurant_path(restaurant), class: "btn btn-sm btn-light border text-primary", title: "Edit" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= button_to admin_restaurant_path(restaurant), method: :delete, class: "btn btn-sm btn-light border text-danger", title: "Delete", data: { turbo_confirm: "Are you sure you want to delete '#{restaurant.name}' and all its menu items?" } do %>
                      <i class="bi bi-trash3"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="text-center py-4 text-muted">
                No restaurants added yet. Click "Add Restaurant" to create one.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
