<div class="container py-4">
  <!-- Admin Header -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <h1 class="h3 fw-bold mb-0">Admin Management Console</h1>
        <span class="badge bg-danger">Restricted</span>
      </div>
      <p class="text-muted small mb-0">Overview of restaurants, menu items, platform orders, and operations</p>
    </div>

    <!-- Quick Navigation Links -->
    <div class="d-flex flex-wrap gap-2">
      <%= link_to admin_restaurants_path, class: "btn btn-outline-dark btn-sm rounded-pill px-3" do %>
        <i class="bi bi-shop me-1"></i> Restaurants
      <% end %>
      <%= link_to admin_products_path, class: "btn btn-outline-dark btn-sm rounded-pill px-3" do %>
        <i class="bi bi-egg-fried me-1"></i> Menu Items
      <% end %>
      <%= link_to admin_orders_path, class: "btn btn-outline-dark btn-sm rounded-pill px-3" do %>
        <i class="bi bi-bag-check me-1"></i> All Orders
      <% end %>
    </div>
  </div>

  <!-- Key Metrics Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 rounded-4 shadow-sm p-3 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-bold text-uppercase">Total Revenue</span>
          <span class="bg-success-subtle text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
            <i class="bi bi-currency-rupee"></i>
          </span>
        </div>
        <div class="fs-4 fw-bold text-dark">₹<%= @total_revenue %></div>
        <div class="small text-muted">Across all completed orders</div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 rounded-4 shadow-sm p-3 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-bold text-uppercase">Total Orders</span>
          <span class="bg-primary-subtle text-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
            <i class="bi bi-bag-check"></i>
          </span>
        </div>
        <div class="fs-4 fw-bold text-dark"><%= @total_orders %></div>
        <div class="small text-muted"><%= @active_orders.count %> currently active</div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 rounded-4 shadow-sm p-3 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-bold text-uppercase">Partner Restaurants</span>
          <span class="bg-warning-subtle text-warning rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
            <i class="bi bi-shop"></i>
          </span>
        </div>
        <div class="fs-4 fw-bold text-dark"><%= @total_restaurants %></div>
        <div class="small text-muted">Operating in Pune</div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 rounded-4 shadow-sm p-3 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-bold text-uppercase">Menu Catalog</span>
          <span class="bg-info-subtle text-info rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
            <i class="bi bi-card-checklist"></i>
          </span>
        </div>
        <div class="fs-4 fw-bold text-dark"><%= @total_products %></div>
        <div class="small text-muted">Active food items</div>
      </div>
    </div>
  </div>

  <!-- Recent / Active Orders Table -->
  <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h2 class="h5 fw-bold mb-0">Active Deliveries & Order Operations</h2>
        <p class="text-muted small mb-0">Advance status to test customer tracking timeline</p>
      </div>
      <%= link_to "View All Orders", admin_orders_path, class: "btn btn-sm btn-outline-secondary rounded-pill" %>
    </div>

    <% if @recent_orders.any? %>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead class="table-light small">
            <tr>
              <th>Order ID</th>
              <th>Customer</th>
              <th>Restaurant</th>
              <th>Total</th>
              <th>Current Status</th>
              <th>Advance Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_orders.each do |order| %>
              <tr>
                <td><strong>#ZGI-<%= order.id %></strong></td>
                <td>

                  <div class="fw-semibold"><%= order.customer_name %></div>
                  <div class="small text-muted"><%= order.contact_phone %></div>
                </td>
                <td><%= order.restaurant&.name || "N/A" %></td>
                <td><strong>₹<%= order.total %></strong></td>
                <td>
                  <span class="<%= order.status_badge_class %>">
                    <%= order.order_status.titleize %>
                  </span>
                </td>
                <td>
                  <!-- Quick status advancement dropdown -->
                  <%= form_with url: admin_order_path(order), method: :patch, local: true, class: "d-inline-flex gap-1 align-items-center" do %>
                    <select name="order_status" class="form-select form-select-sm" style="width: 145px;" onchange="this.form.submit()">
                      <% Order::STATUSES.each do |st| %>
                        <option value="<%= st %>" <%= 'selected' if order.order_status == st %>><%= st.titleize %></option>
                      <% end %>
                    </select>
                  <% end %>
                </td>
                <td>
                  <%= link_to "Details", order_path(order), class: "btn btn-sm btn-light border" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-4 text-muted">
        No orders placed yet. Place an order from the customer interface to test!
      </div>
    <% end %>
  </div>
</div>
