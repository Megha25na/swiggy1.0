<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5 bg-white">
        <!-- Brand Header -->
        <div class="text-center mb-4">
          <div class="brand-logo justify-content-center mb-2">
            <span>Swigy</span>
            <span class="logo-badge"><i class="bi bi-bicycle"></i></span>
          </div>
          <h1 class="h4 fw-bold text-dark mb-1">Create your Account</h1>
          <p class="text-muted small">Join Swigy for the fastest, hottest food delivery experience</p>
        </div>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="row g-3 mb-3">
            <div class="col-sm-6">
              <%= f.label :name, "Full Name", class: "form-label small fw-bold" %>
              <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "form-control rounded-3", placeholder: "e.g. Rahul Sharma", required: true %>
            </div>

            <div class="col-sm-6">
              <%= f.label :phone, "Phone Number", class: "form-label small fw-bold" %>
              <%= f.telephone_field :phone, class: "form-control rounded-3", placeholder: "e.g. 9876543210" %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :email, "Email Address", class: "form-label small fw-bold" %>
            <%= f.email_field :email, autocomplete: "email", class: "form-control rounded-3", placeholder: "you@example.com", required: true %>
          </div>

          <div class="mb-3">
            <%= f.label :address, "Delivery Address", class: "form-label small fw-bold" %>
            <%= f.text_area :address, rows: 2, class: "form-control rounded-3", placeholder: "Flat / House No., Society, Landmark, Pune" %>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-sm-6">
              <%= f.label :password, "Password", class: "form-label small fw-bold" %>
              <% if @minimum_password_length %>
                <span class="text-muted" style="font-size: 0.75rem;">(<%= @minimum_password_length %> chars min)</span>
              <% end %>
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control rounded-3", placeholder: "••••••••", required: true %>
            </div>

            <div class="col-sm-6">
              <%= f.label :password_confirmation, "Confirm Password", class: "form-label small fw-bold" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control rounded-3", placeholder: "••••••••", required: true %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.submit "Create Account", class: "btn btn-swigy-primary w-100 py-2 fs-6" %>
          </div>
        <% end %>

        <div class="text-center pt-3 border-top mt-3 small text-muted">
          Already have an account? 
          <%= link_to "Sign In", new_session_path(resource_name), class: "text-warning fw-bold text-decoration-none" %>
        </div>
      </div>
    </div>
  </div>
</div>
