<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5 bg-white">
        <!-- Brand Header -->
        <div class="text-center mb-4">
          <div class="brand-logo justify-content-center mb-2">
            <span>Swigy</span>
            <span class="logo-badge"><i class="bi bi-bicycle"></i></span>
          </div>
          <h1 class="h4 fw-bold text-dark mb-1">Welcome Back!</h1>
          <p class="text-muted small">Sign in to order delicious food and track your deliveries</p>
        </div>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="mb-3">
            <%= f.label :email, "Email Address", class: "form-label small fw-bold" %>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control border-start-0 ps-0", placeholder: "you@example.com", required: true %>
            </div>
          </div>

          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center">
              <%= f.label :password, "Password", class: "form-label small fw-bold" %>
              <% if devise_mapping.recoverable? %>
                <%= link_to "Forgot Password?", new_password_path(resource_name), class: "small text-warning text-decoration-none" %>
              <% end %>
            </div>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
              <%= f.password_field :password, autocomplete: "current-password", class: "form-control border-start-0 ps-0", placeholder: "••••••••", required: true %>
            </div>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="form-check mb-4">
              <%= f.check_box :remember_me, class: "form-check-input" %>
              <%= f.label :remember_me, "Keep me signed in", class: "form-check-label small text-muted" %>
            </div>
          <% end %>

          <div class="mb-3">
            <%= f.submit "Sign In", class: "btn btn-swigy-primary w-100 py-2 fs-6" %>
          </div>
        <% end %>

        <div class="text-center pt-3 border-top mt-3 small text-muted">
          Don't have an account? 
          <%= link_to "Sign Up", new_registration_path(resource_name), class: "text-warning fw-bold text-decoration-none" %>
        </div>

        <!-- Demo credentials info card -->
        <div class="mt-4 p-3 rounded-3 bg-light border small">
          <div class="fw-bold text-dark mb-1"><i class="bi bi-info-circle me-1 text-primary"></i> Demo Login Accounts:</div>
          <div><strong class="text-secondary">Admin:</strong> rahulgawade2006@gmail.com</div>
          <div><strong class="text-secondary">Customer:</strong> abc@gmail.com</div>
        </div>
      </div>
    </div>
  </div>
</div>
