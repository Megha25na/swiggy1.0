<!-- Hero Section -->
<section class="hero-banner">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3">
          <i class="bi bi-lightning-charge-fill me-1"></i> Superfast Delivery in 25-30 Mins
        </span>
        <h1 class="hero-title mb-3">
          Craving Delicious Food? <span>We deliver.</span>
        </h1>
        <p class="hero-subtitle">
          Discover top-rated restaurants, authentic cuisines, and hot trending dishes delivered fast right to your doorstep.
        </p>

        <!-- Search Bar -->
        <%= form_with url: search_path, method: :get, local: true, class: "hero-search-box mb-3" do |f| %>
          <i class="bi bi-search text-warning fs-5 me-2"></i>
          <%= f.text_field :q, placeholder: "Search for 'Biryani', 'Pizza', 'Burger', or restaurant...", aria: { label: "Search food or restaurants" } %>
          <button type="submit" class="btn btn-swigy-primary rounded-pill px-4">Find Food</button>
        <% end %>

        <!-- Popular Tags -->
        <div class="d-flex align-items-center flex-wrap gap-2 text-muted small">
          <span class="fw-bold text-dark">Popular:</span>
          <%= link_to "Biryani", search_path(q: "Biryani"), class: "badge bg-white text-secondary border rounded-pill px-3 py-2 text-decoration-none" %>
          <%= link_to "Pizza", search_path(q: "Pizza"), class: "badge bg-white text-secondary border rounded-pill px-3 py-2 text-decoration-none" %>
          <%= link_to "Burger", search_path(q: "Burger"), class: "badge bg-white text-secondary border rounded-pill px-3 py-2 text-decoration-none" %>
          <%= link_to "Paneer", search_path(q: "Paneer"), class: "badge bg-white text-secondary border rounded-pill px-3 py-2 text-decoration-none" %>
          <%= link_to "Desserts", search_path(q: "Dessert"), class: "badge bg-white text-secondary border rounded-pill px-3 py-2 text-decoration-none" %>
        </div>
      </div>

      <div class="col-lg-5 d-none d-lg-block text-center">
        <div class="position-relative">
          <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=700&q=80" 
               alt="Delicious Food Spread" 
               class="img-fluid rounded-4 shadow-lg"
               style="max-height: 380px; object-fit: cover; width: 100%;">
          <div class="position-absolute bottom-0 start-0 translate-middle-y bg-white p-3 rounded-4 shadow-lg border d-flex align-items-center gap-3 ms-n3" style="max-width: 250px;">
            <div class="bg-success text-white rounded-circle p-2 fs-4 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
              <i class="bi bi-shield-check"></i>
            </div>
            <div class="text-start">
              <div class="fw-bold small text-dark">Hygiene Assured</div>
              <div class="text-muted" style="font-size: 0.75rem;">100% contactless & safety certified</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Food Categories Rail -->
<section class="py-5 bg-white border-bottom">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="h4 fw-bold mb-1">What's on your mind?</h2>
        <p class="text-muted small mb-0">Explore our most popular cuisines & cravings</p>
      </div>
      <%= link_to restaurants_path, class: "btn-swigy-outline btn-sm rounded-pill" do %>
        View All <i class="bi bi-arrow-right"></i>
      <% end %>
    </div>

    <div class="row row-cols-4 row-cols-md-8 g-3 text-center">
      <% @categories.each do |cat| %>
        <div class="col">
          <%= link_to search_path(q: cat[:name]), class: "category-card" do %>
            <div class="category-img-wrapper">
              <img src="<%= cat[:image] %>" alt="<%= cat[:name] %>" loading="lazy">
            </div>
            <h3 class="category-title"><%= cat[:name] %></h3>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- Promotional Banner Strip -->
<section class="py-4" style="background-color: #FFF6EE;">
  <div class="container">
    <div class="row g-3">
      <div class="col-md-6">
        <div class="p-4 rounded-4 shadow-sm d-flex align-items-center justify-content-between text-white" style="background: linear-gradient(135deg, #FC8019 0%, #FF993A 100%);">
          <div>
            <span class="badge bg-white text-dark fw-bold mb-2">LIMITED TIME</span>
            <h3 class="h4 fw-bold mb-1">Flat 50% OFF</h3>
            <p class="small mb-3 text-white-50">On orders above ₹199. Code: <strong>SWIGY50</strong></p>
            <%= link_to "Order Now", restaurants_path, class: "btn btn-light btn-sm fw-bold px-3 rounded-pill text-warning" %>
          </div>
          <div class="fs-1 opacity-75 d-none d-sm-block">
            <i class="bi bi-tag-fill" style="font-size: 4rem;"></i>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="p-4 rounded-4 shadow-sm d-flex align-items-center justify-content-between text-white" style="background: linear-gradient(135deg, #1C1C24 0%, #323546 100%);">
          <div>
            <span class="badge bg-success fw-bold mb-2">FREE DELIVERY</span>
            <h3 class="h4 fw-bold mb-1">Swigy Super Pass</h3>
            <p class="small mb-3 text-white-50">Unlimited free delivery from top restaurants</p>
            <%= link_to "Explore Offers", offers_path, class: "btn btn-outline-light btn-sm fw-bold px-3 rounded-pill" %>
          </div>
          <div class="fs-1 opacity-75 d-none d-sm-block">
            <i class="bi bi-bicycle" style="font-size: 4rem;"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Top Restaurants in Pune -->
<section class="py-5">
  <div class="container">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
      <div>
        <h2 class="h3 fw-bold mb-1">Top Rated Restaurants in Pune</h2>
        <p class="text-muted small mb-0">Highest rated dining experiences delivered to your couch</p>
      </div>

      <!-- Quick Filter Chips -->
      <div class="filter-bar mb-0">
        <%= link_to "All", root_path, class: "filter-pill #{'active' unless params[:filter].present?}" %>
        <%= link_to "Fast Delivery", root_path(filter: "fast_delivery"), class: "filter-pill #{'active' if params[:filter] == 'fast_delivery'}" %>
        <%= link_to "Rating 4.3+", root_path(filter: "top_rated"), class: "filter-pill #{'active' if params[:filter] == 'top_rated'}" %>
        <%= link_to "Pure Veg", root_path(filter: "pure_veg"), class: "filter-pill #{'active' if params[:filter] == 'pure_veg'}" %>
      </div>
    </div>

    <!-- Restaurants Grid -->
    <div class="row g-4">
      <% if @all_restaurants.any? %>
        <% @all_restaurants.each do |restaurant| %>
          <%= render partial: "restaurants/restaurant_card", locals: { restaurant: restaurant } %>
        <% end %>
      <% else %>
        <div class="col-12 text-center py-5">
          <div class="p-5 bg-white rounded-4 border">
            <i class="bi bi-emoji-neutral fs-1 text-muted mb-3 d-block"></i>
            <h4 class="fw-bold">No restaurants found</h4>
            <p class="text-muted">Try clearing filters to see all available restaurants.</p>
            <%= link_to "Reset Filters", root_path, class: "btn btn-swigy-primary rounded-pill px-4" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
