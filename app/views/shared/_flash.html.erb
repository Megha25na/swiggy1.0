<% if notice.present? %>
  <div class="container mt-3">
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm border-0 rounded-3 py-2 px-3" role="alert" style="background-color: #E7F6F0; color: #0F8A65;">
      <i class="bi bi-check-circle-fill me-2 fs-5"></i>
      <div class="flex-grow-1 font-semibold"><%= notice %></div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </div>
<% end %>

<% if alert.present? %>
  <div class="container mt-3">
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm border-0 rounded-3 py-2 px-3" role="alert" style="background-color: #FEECEF; color: #E43B4F;">
      <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
      <div class="flex-grow-1 font-semibold"><%= alert %></div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </div>
<% end %>
